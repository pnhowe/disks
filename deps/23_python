#!/bin/sh
#SOURCE: https://www.python.org/ftp/python/3.14.10/Python-3.14.10.tar.xz
#HASH: 5b66b69732cd99929643817cf0e1b470445d2794
# when updating python, make sure to update the version number in the paths below

set -e
#set -x

# we don't need everything, so only these subdirs
# lib2to3 is there b/c the install will not work with out it, going to remove that during the install function
SUBDIRS="re encodings serial json config ctypes logging sqlite3 collections urllib email http asyncio concurrent concurrent/futures multiprocessing multiprocessing/dummy importlib importlib/metadata importlib/resources lib2to3 time zoneinfo xml xml/dom xml/parses xml/sax xml/etree string pathlib sysconfig"

build()
{
  # site is techinically only for arm/arm64
  echo "ac_cv_file__dev_ptmx=yes
ac_cv_file__dev_ptc=yes" > config.site

# patching to support openssl 4, remove when moving past python version 3.14
  cat <<PATCH | patch -p1
--- a/Modules/_ssl.c
+++ b/Modules/_ssl.c
@@ -136,6 +136,13 @@ static void _PySSLFixErrno(void) {
 #error Unsupported OpenSSL version
 #endif

+#if (OPENSSL_VERSION_NUMBER >= 0x40000000L)
+#  define OPENSSL_NO_SSL3
+#  define OPENSSL_NO_TLS1
+#  define OPENSSL_NO_TLS1_1
+#  define OPENSSL_NO_TLS1_2
+#endif
+
 /* OpenSSL API 1.1.0+ does not include version methods */
 #ifndef OPENSSL_NO_SSL3_METHOD
 extern const SSL_METHOD *SSLv3_method(void);
@@ -6606,9 +6613,15 @@ sslmodule_init_constants(PyObject *m)
     ADD_INT_CONST("PROTOCOL_TLS", PY_SSL_VERSION_TLS);
     ADD_INT_CONST("PROTOCOL_TLS_CLIENT", PY_SSL_VERSION_TLS_CLIENT);
     ADD_INT_CONST("PROTOCOL_TLS_SERVER", PY_SSL_VERSION_TLS_SERVER);
+#ifndef OPENSSL_NO_TLS1
     ADD_INT_CONST("PROTOCOL_TLSv1", PY_SSL_VERSION_TLS1);
+#endif
+#ifndef OPENSSL_NO_TLS1_1
     ADD_INT_CONST("PROTOCOL_TLSv1_1", PY_SSL_VERSION_TLS1_1);
+#endif
+#ifndef OPENSSL_NO_TLS1_2
     ADD_INT_CONST("PROTOCOL_TLSv1_2", PY_SSL_VERSION_TLS1_2);
+#endif

 #define ADD_OPTION(NAME, VALUE) if (sslmodule_add_option(m, NAME, (VALUE)) < 0) return -1
PATCH

  export CONFIG_SITE=config.site
  if [ "x$1" = "xx86_64" ]
  then
    ./configure --prefix=/ --enable-ipv6 --with-tzpath=/etc/zoneinfo
  elif [ "x$1" = "xarm64" ]
  then
    ./configure --prefix=/ --enable-ipv6 --with-tzpath=/etc/zoneinfo --host aarch64-linux-gnu --build x86_64-pc-linux-gnu
  fi

  make python $2
  LIBSUBDIRS=$SUBDIRS make -e build_all $2
  prefix=/pythonlib LIBSUBDIRS=$SUBDIRS TEST_MODULES=no make install -e libinstall
  prefix=/pythonlib LIBSUBDIRS=$SUBDIRS TEST_MODULES=no make install -e sharedinstall

  rm -fr /pythonlib/lib/python3.1*/lib2to3
  rm -fr /pythonlib/lib/python3.*/*.dist-info
  rm -fr /pythonlib/include
  rm -fr /pythonlib/share
  rm -fr /pythonlib/bin

  find /pythonlib -type d -name __pycache__ -exec rm -fr {} +
}

install()
{
  cp -f python $1/bin/
  cp -a ../../pythonlib/* $1

  ln -sf python $1/bin/python3

  pip3 install --no-compile --upgrade --target $1/lib/python3/ cinp python-dateutil httpcore[asyncio]

  cat <<CUSTOMIZE > $1/lib/python3.14/sitecustomize.py
import sys

sys.path.append( '/lib/python3/' )
CUSTOMIZE

  cp -a /usr/share/zoneinfo $1/etc
}

binaries()
{
  ls python
  ls ../../pythonlib/lib/python3.14/lib-dynload/*.so
}
