#!/bin/sh
#SOURCE: https://cdn.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-10.6p2.tar.gz
#HASH: c91a0b7860c80f29db874044af4d1a6f906231d9

set -e
#set -x

build()
{
  if [ "x$1" = "xx86_64" ]
  then
    ./configure --prefix= --libexecdir=/sbin --without-pam --sysconfdir=/etc/ssh --with-privsep-path=/var/empty
  elif [ "x$1" = "xarm64" ]
  then
    ./configure --prefix= --libexecdir=/sbin --without-pam --sysconfdir=/etc/ssh --with-privsep-path=/var/empty --host aarch64-linux-gnu --build x86_64-pc-linux-gnu
  fi
  make $2
}

install()
{
  cp -f sshd $1/sbin
  cp -f sshd-session $1/sbin
  cp -f ssh $1/bin
  cp -f sftp-server $1/sbin
  cp -f scp $1/bin
  cp -f ssh-keygen $1/bin
}

binaries()
{
  ls sshd
  ls sshd-session
  ls ssh
  ls sftp-server
  ls scp
  ls ssh-keygen
}
